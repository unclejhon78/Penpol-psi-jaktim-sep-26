<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Admin - Absensi Seminar</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f6f9;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            background: #ffffff;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        h2 {
            color: #0056b3;
            margin-bottom: 5px;
        }

        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 10px;
        }

        input[type="text"] {
            padding: 8px 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            width: 250px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
            font-size: 14px;
        }

        th {
            background-color: #f8f9fa;
        }

        .btn {
            padding: 6px 12px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }

        .btn-success { background-color: #28a745; color: white; }
        .btn-disabled { background-color: #6c757d; color: white; cursor: not-allowed; }

        .badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            color: white;
            font-weight: bold;
        }

        .badge-success { background-color: #28a745; }
        .badge-warning { background-color: #ffc107; color: #333; }
    </style>
</head>
<body>

<div class="container">
    <div class="header-bar">
        <div>
            <h2>Portal Admin - Registrasi Ulang (Hari H)</h2>
            <small>Data disinkronkan secara realtime dengan Google Sheets</small>
        </div>
        <div>
            <input type="text" id="searchInput" onkeyup="filterData()" placeholder="Cari nama / no HP...">
            <button class="btn btn-success" onclick="loadData()">Refresh Data</button>
        </div>
    </div>

    <table id="adminTable">
        <thead>
            <tr>
                <th>No</th>
                <th>Nama Peserta</th>
                <th>No HP</th>
                <th>Wilayah</th>
                <th>Pengurus & Jabatan</th>
                <th>Status</th>
                <th>Aksi Reg. Ulang</th>
            </tr>
        </thead>
        <tbody id="tableBody">
            <tr>
                <td colspan="7" style="text-align:center;">Memuat data dari Google Sheets...</td>
            </tr>
        </tbody>
    </table>
</div>

<script>
    // MASUKKAN URL GOOGLE APPS SCRIPT ANDA DI SINI
    const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzNlECyDS2S6g57dcd31kWL1_EXkrgwzxm3NULV5vIxxRuaPpKQzsduWbsvNW4_FSMh/exec";
    let listPeserta = [];

    window.onload = function() {
        loadData();
    };

    function loadData() {
        document.getElementById('tableBody').innerHTML = '<tr><td colspan="7" style="text-align:center;">Memuat data...</td></tr>';
        
        fetch(SCRIPT_URL)
        .then(res => res.json())
        .then(response => {
            if (response.result === 'success') {
                listPeserta = response.data;
                renderTable(listPeserta);
            }
        })
        .catch(err => {
            alert('Gagal mengambil data dari Google Sheets');
            console.error(err);
        });
    }

    function renderTable(data) {
        const tbody = document.getElementById('tableBody');
        tbody.innerHTML = '';

        if(data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;">Belum ada peserta terdaftar.</td></tr>';
            return;
        }

        data.forEach((p, idx) => {
            const statusBadge = p.statusHadir 
                ? '<span class="badge badge-success">Hadir</span>' 
                : '<span class="badge badge-warning">Belum Hadir</span>';

            const actionBtn = p.statusHadir
                ? `<button class="btn btn-disabled" disabled>Sudah Hadir</button>`
                : `<button class="btn btn-success" onclick="markAttendance(${idx})">Klik Hadir</button>`;

            tbody.innerHTML += `
                <tr>
                    <td>${idx + 1}</td>
                    <td><strong>${p.nama}</strong><br><small>${p.email}</small></td>
                    <td>${p.noHp}</td>
                    <td>Kec. ${p.kecamatan}<br>Kel. ${p.kelurahan}</td>
                    <td>${p.pengurus} - ${p.jabatan}</td>
                    <td>${statusBadge}</td>
                    <td>${actionBtn}</td>
                </tr>
            `;
        });
    }

    function markAttendance(index) {
        const peserta = listPeserta[index];

        if(confirm(`Konfirmasi kehadiran untuk: ${peserta.nama}?`)) {
            const payload = {
                action: 'absensi',
                nama: peserta.nama,
                noHp: peserta.noHp,
                pengurus: peserta.pengurus,
                jabatan: peserta.jabatan,
                kecamatan: peserta.kecamatan,
                kelurahan: peserta.kelurahan
            };

            fetch(SCRIPT_URL, {
                method: 'POST',
                mode: 'no-cors',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(() => {
                alert(`Kehadiran ${peserta.nama} berhasil dicatat! Data masuk ke Sheet "Kehadiran".`);
                loadData(); // Auto refresh
            })
            .catch(err => alert('Gagal mencatat kehadiran.'));
        }
    }

    function filterData() {
        const query = document.getElementById('searchInput').value.toLowerCase();
        const filtered = listPeserta.filter(p => 
            p.nama.toLowerCase().includes(query) || 
            p.noHp.includes(query)
        );
        renderTable(filtered);
    }
</script>

</body>
</html>
